# EdgeOfTimeRecomp for the PS5 - the game (included by reeot/reeot.cmake).
#
# Builds EdgeOfTimeRecomp (${reeot_eotr}) for the title, as its desktop build does
# (its CMakeLists.txt), from:
#
#   - the game's recompiled code, which `rexglue codegen reeot_manifest.toml` writes
#     to its generated/default (Default.xex) and generated/gamelogic (GameLogic.dll)
#     from your own game files: reeot_recomp, and reeot_gamelogic with the module's
#     own sources, joined into one object (reeot/prelink_module.py) and registered
#     under its library's name (reeot/gamelogic_static.cpp);
#   - the repository's sources for the PS5 (its ps5/reeot-sources.cmake): reeot_game;
#   - zstd (its XenosRecomp's): reeot_zstd. xxHash is the runtime's.
#
# What the desktop build makes from the game's files besides the code is not made
# here: the game's recompiled shaders (generated/shader_cache.cpp) are used when
# they are there, and the port's packages come from the game folder copied from a
# PC install (so none are embedded: src/installer/self_install.cpp leaves them).
#
# Needs dxc (DirectXShaderCompiler, on the PATH or REEOT_DXC) for the host shaders,
# and Python 3.
#
# Copyright (C) 2026 KongaTime
# SPDX-License-Identifier: MIT

foreach(module default gamelogic)
	if(NOT EXISTS ${reeot_eotr}/generated/${module}/sources.cmake)
		message(FATAL_ERROR "No recompiled game code at ${reeot_eotr}/generated/${module}: put your Default.xex "
			"and Default.xexp, and Data/GameLogic.dll and Data/GameLogic.dllp, in ${reeot_eotr}/assets, then "
			"run `rexglue codegen reeot_manifest.toml` there (ReXGlue nightly-20261002-bd833a2a)")
	endif()
endforeach()
# The PS5 maps memory at 64 KiB granularity, so the runtime maps the guest's
# 0xE0000000 range without its 4 KiB offset and the code must add it, as on
# Windows (rex::memory::detail::PhysicalHostOffset). The fork's codegen template
# says so for the PS5; code generated by an upstream rexglue does not, and every
# access above 0xE0000000 then misses by 4 KiB (the boot stalled on a lock read
# from the wrong place, run 8, 2026-10-12): such a header is given the PS5 here.
foreach(module default gamelogic)
	set(reeot_pch ${reeot_eotr}/generated/${module}/reeot_pch.h)
	file(READ ${reeot_pch} reeot_pch_text)
	if(reeot_pch_text MATCHES "REX_ARCH_ARM64\\)\n#define REX_PHYS_HOST_OFFSET")
		string(REPLACE "#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)\n#define REX_PHYS_HOST_OFFSET"
			"#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64) || REX_PLATFORM_PS5\n#define REX_PHYS_HOST_OFFSET"
			reeot_pch_text "${reeot_pch_text}")
		file(WRITE ${reeot_pch} "${reeot_pch_text}")
		message(STATUS "EdgeOfTimeRecomp: ${reeot_pch} given the PS5's 0xE0000000 offset")
	endif()
endforeach()
find_program(REEOT_DXC dxc REQUIRED)
find_program(reeot_python python3 REQUIRED)
include(${reeot_eotr}/ps5/reeot-sources.cmake)

set(reeot_gen ${CMAKE_BINARY_DIR}/reeot_gen)
file(MAKE_DIRECTORY ${reeot_gen}/core ${reeot_gen}/installer ${reeot_gen}/shaders)

# The runtime's headers and settings, which every part of the game builds with
set(reeot_rex_includes ${reeot_rexglue}/include ${reeot_runtime_build}/include
	${reeot_rexglue}/thirdparty/fmt/include ${reeot_rexglue}/thirdparty/spdlog/include
	${reeot_rexglue}/thirdparty/simde ${reeot_rexglue}/thirdparty/simde/simde
	${reeot_rexglue}/thirdparty/utfcpp/source ${reeot_rexglue}/thirdparty/imgui
	${reeot_rexglue}/thirdparty/tomlplusplus/include ${reeot_rexglue}/thirdparty/xxHash)
set(reeot_rex_definitions SPDLOG_COMPILED_LIB SPDLOG_FMT_EXTERNAL REX_HAS_VULKAN=1
	REXGLUE_BUILD_CONFIG="Release" NDEBUG)
set(reeot_rex_options -std=c++23 -fexperimental-library -fno-strict-aliasing -march=znver2
	-fno-omit-frame-pointer -ffunction-sections -fdata-sections)

# --- Generated sources and headers --------------------------------------------

# core/build_info.h: this repository's version and commit, the PS5 as the platform
file(READ ${reeot_eotr}/CMakeLists.txt reeot_cmakelists)
string(REGEX MATCH "project\\(reeot VERSION ([0-9.]+)" _ "${reeot_cmakelists}")
set(reeot_VERSION ${CMAKE_MATCH_1})
execute_process(COMMAND git -C ${reeot_eotr} rev-parse --short=9 HEAD
	OUTPUT_VARIABLE REEOT_GIT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C ${reeot_eotr} rev-parse --abbrev-ref HEAD
	OUTPUT_VARIABLE REEOT_GIT_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C ${reeot_eotr} status --porcelain --untracked-files=no
	OUTPUT_VARIABLE reeot_git_status ERROR_QUIET)
set(REEOT_GIT_DIRTY 0)
if(reeot_git_status)
	set(REEOT_GIT_DIRTY 1)
endif()
set(REEOT_BUILD_PLATFORM ps5-amd64)
set(REEOT_BUILD_COMPILER "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
string(TIMESTAMP REEOT_BUILD_TIMESTAMP "%Y%m%d_%H%M")
configure_file(${reeot_eotr}/cmake/build_info.h.in ${reeot_gen}/core/build_info.h @ONLY)

# embedded.h and its sources: res/embed, as the desktop build embeds it
include(${reeot_eotr}/cmake/embed.cmake)
reeot_embed_directory(ROOT ${reeot_eotr}/res/embed HEADER ${reeot_gen}/embedded.h SOURCES_VAR reeot_embed_sources)

# The port's packages, empty: the game folder from a PC install holds them
set(reeot_packages_cpp "// Generated by reeot/reeot_game.cmake - do not edit.\n#include <cstddef>\n#include <cstdint>\n")
foreach(package embedded_package:EmbeddedPortPackage:pkz/ReeotUI.pkz
		embedded_menu_package:EmbeddedMenuPackage:pkz/ReeotMenu.pkz
		embedded_achievements_package:EmbeddedAchievementsPackage:pkz/ReeotAchievements.pkz
		embedded_icons_package:EmbeddedIconsPackage:pkz/ReeotIcons.pkz
		embedded_suits_package:EmbeddedSuitsPackage:pkz/ReeotSuits.pkz)
	string(REPLACE ":" ";" parts ${package})
	list(GET parts 0 header)
	list(GET parts 1 accessor)
	list(GET parts 2 name)
	string(REGEX REPLACE "[^A-Za-z0-9]" "_" symbol "eot_embed_${name}")
	file(CONFIGURE OUTPUT ${reeot_gen}/${header}.h CONTENT "// Generated by reeot/reeot_game.cmake - do not edit.
#pragma once

#include <cstddef>
#include <cstdint>

#include \"embedded.h\"

extern const uint8_t ${symbol}[];
extern const size_t ${symbol}_size;

namespace eot {

// ${name}: not embedded in the PS5 title (the game folder holds it).
inline EmbeddedAsset ${accessor}() { return {\"${name}\", ${symbol}, ${symbol}_size}; }

} // namespace eot
")
	string(APPEND reeot_packages_cpp "extern const uint8_t ${symbol}[] = {0};\nextern const size_t ${symbol}_size = 0;\n")
endforeach()
file(CONFIGURE OUTPUT ${reeot_gen}/reeot_packages.cpp CONTENT "${reeot_packages_cpp}")

# installer/program_files.h: what the title is made of
file(CONFIGURE OUTPUT ${reeot_gen}/installer/program_files.h CONTENT "// Generated by reeot/reeot_game.cmake - do not edit.
#pragma once

inline constexpr const char *kProgramFiles[] = {
    \"eboot.bin\",
};
")

# The HUD aspect policy
add_custom_command(OUTPUT ${reeot_gen}/hud_aspect_policy.inc
	COMMAND ${reeot_python} ${reeot_eotr}/tools/hud/gen_hud_policy.py
		${reeot_eotr}/config/eot_hud_aspect.toml ${reeot_gen}/hud_aspect_policy.inc
	DEPENDS ${reeot_eotr}/config/eot_hud_aspect.toml ${reeot_eotr}/tools/hud/gen_hud_policy.py
	COMMENT "EdgeOfTimeRecomp: the HUD aspect policy" VERBATIM)

# The host shaders, as SPIR-V (cmake/host_shaders.cmake's Vulkan settings)
set(reeot_hlsl ${reeot_eotr}/src/gpu/shaders/hlsl)
file(GLOB reeot_hlsli ${reeot_hlsl}/*.hlsli)
set(reeot_shader_headers)
foreach(shader ${REEOT_PS5_HOST_SHADERS})
	string(REPLACE ":" ";" parts ${shader})
	list(GET parts 0 stem)
	list(GET parts 1 profile)
	set(arguments -spirv -fvk-use-dx-layout)
	if(profile MATCHES "^vs")
		list(APPEND arguments -fvk-invert-y)
	endif()
	set(header ${reeot_gen}/shaders/${stem}.hlsl.spirv.h)
	add_custom_command(OUTPUT ${header}
		COMMAND ${REEOT_DXC} -T ${profile} -HV 2021 -all-resources-bound -Wno-ignored-attributes ${arguments}
			-I ${reeot_hlsl} -Fh ${header} ${reeot_hlsl}/${stem}.hlsl -Vn g_${stem}_spirv
		DEPENDS ${reeot_hlsl}/${stem}.hlsl ${reeot_hlsli}
		COMMENT "EdgeOfTimeRecomp: host shader ${stem}.hlsl (${profile}, SPIR-V)" VERBATIM)
	list(APPEND reeot_shader_headers ${header})
endforeach()

# The game's shaders, when the recompiled cache is there: split
# (ps5/tools/split-shader-cache.py), its compressed SPIR-V a file beside
# eboot.bin, shader-cache.zst; or whole, linked in
if(EXISTS ${reeot_eotr}/generated/shader_cache_ps5.cpp)
	set(reeot_shader_cache ${reeot_eotr}/generated/shader_cache_ps5.cpp)
	message(STATUS "EdgeOfTimeRecomp: the game's shaders from ${reeot_shader_cache}, with "
		"${reeot_eotr}/generated/shader-cache.zst beside eboot.bin")
elseif(EXISTS ${reeot_eotr}/generated/shader_cache.cpp)
	set(reeot_shader_cache ${reeot_eotr}/generated/shader_cache.cpp)
	message(STATUS "EdgeOfTimeRecomp: the game's shaders from ${reeot_shader_cache}")
else()
	set(reeot_shader_cache ${reeot_eotr}/src/gpu/shaders/shader_cache_empty.cpp)
	message(WARNING "EdgeOfTimeRecomp: no generated/shader_cache.cpp, so the game's own shaders are left out "
		"and it will draw little or nothing")
endif()
add_library(reeot_shader_cache OBJECT ${reeot_shader_cache})
target_include_directories(reeot_shader_cache PRIVATE ${reeot_eotr}/src/gpu/shaders)
target_compile_options(reeot_shader_cache PRIVATE -O0 -w)

# --- The game's recompiled code -----------------------------------------------

include(${reeot_eotr}/generated/default/sources.cmake)
add_library(reeot_recomp OBJECT ${GENERATED_SOURCES})
include(${reeot_eotr}/generated/gamelogic/sources.cmake)
list(TRANSFORM REEOT_PS5_GAMELOGIC_SOURCES PREPEND ${reeot_eotr}/)
add_library(reeot_gamelogic OBJECT ${GENERATED_SOURCES} ${REEOT_PS5_GAMELOGIC_SOURCES})
foreach(target_module reeot_recomp:default reeot_gamelogic:gamelogic)
	string(REPLACE ":" ";" parts ${target_module})
	list(GET parts 0 target)
	list(GET parts 1 module)
	target_include_directories(${target} PRIVATE ${reeot_eotr} ${reeot_eotr}/src
		${reeot_eotr}/generated/${module} ${reeot_gen} ${reeot_rex_includes})
	target_compile_definitions(${target} PRIVATE ${reeot_rex_definitions})
	# As rexglue_apply_target_settings, at -O2 (the code is large)
	target_compile_options(${target} PRIVATE ${reeot_rex_options} -O2 -mcmodel=large -msse4.1)
	target_precompile_headers(${target} PRIVATE ${reeot_eotr}/generated/${module}/reeot_pch.h)
endforeach()
# As the desktop's shared library, whose names stay its own
set_target_properties(reeot_gamelogic PROPERTIES CXX_VISIBILITY_PRESET hidden)

set(reeot_gamelogic_object ${CMAKE_BINARY_DIR}/reeot_gamelogic.o)
# A target's objects include its precompiled header's (.pch), which no link takes
set(reeot_gamelogic_objects "$<FILTER:$<TARGET_OBJECTS:reeot_gamelogic>,INCLUDE,\\.o$>")
add_custom_command(OUTPUT ${reeot_gamelogic_object}
	COMMAND ${reeot_python} ${ROOT}/reeot/prelink_module.py --bin ${PS5_PAYLOAD_SDK}/bin
		--prefix reeot_GameLogic_ --out ${reeot_gamelogic_object} ${reeot_gamelogic_objects}
	DEPENDS reeot_gamelogic $<TARGET_OBJECTS:reeot_gamelogic> ${ROOT}/reeot/prelink_module.py
	COMMAND_EXPAND_LISTS
	COMMENT "EdgeOfTimeRecomp: the game logic module as one object" VERBATIM)
add_custom_target(reeot_gamelogic_object DEPENDS ${reeot_gamelogic_object})

# --- zstd ---------------------------------------------------------------------

set(reeot_zstd ${reeot_eotr}/thirdparty/XenosRecomp/thirdparty/zstd/lib)
file(GLOB reeot_zstd_sources ${reeot_zstd}/common/*.c ${reeot_zstd}/compress/*.c ${reeot_zstd}/decompress/*.c)
add_library(reeot_zstd OBJECT ${reeot_zstd_sources})
target_include_directories(reeot_zstd PRIVATE ${reeot_zstd} ${reeot_zstd}/common)
# ZSTD_TRACE=0: its trace hooks are weak references, which a title may not import
target_compile_definitions(reeot_zstd PRIVATE ZSTD_DISABLE_ASM ZSTD_TRACE=0 XXH_NAMESPACE=ZSTD_)
target_compile_options(reeot_zstd PRIVATE -O2 -fno-omit-frame-pointer -ffunction-sections -fdata-sections)

# --- This repository's sources ------------------------------------------------

list(TRANSFORM REEOT_PS5_SOURCES PREPEND ${reeot_eotr}/)
add_library(reeot_game OBJECT ${REEOT_PS5_SOURCES} ${reeot_embed_sources} ${reeot_gen}/reeot_packages.cpp
	${reeot_gen}/hud_aspect_policy.inc ${reeot_shader_headers}
	${reeot_eotr}/thirdparty/XenosRecomp/thirdparty/smol-v/source/smolv.cpp ${ROOT}/reeot/gamelogic_static.cpp
	# ReXApp, which the SDK gives an app as a source to build (rexglue_configure_target)
	${reeot_rexglue}/src/ui/rex_app.cpp)
target_include_directories(reeot_game PRIVATE ${reeot_eotr}/src ${reeot_eotr} ${reeot_gen}
	${reeot_eotr}/thirdparty/stb ${reeot_eotr}/thirdparty/XenosRecomp/XenosRecomp ${reeot_eotr}/thirdparty/renderdoc
	${reeot_eotr}/thirdparty/XenosRecomp/thirdparty/smol-v/source ${reeot_eotr}/generated/default
	${reeot_plume} ${reeot_plume}/contrib/volk ${reeot_plume}/contrib/Vulkan-Headers/include
	${reeot_plume}/contrib/VulkanMemoryAllocator/include ${reeot_zstd} ${reeot_rex_includes})
target_compile_definitions(reeot_game PRIVATE ${reeot_rex_definitions} _ITERATOR_DEBUG_LEVEL=0 NOMINMAX
	WIN32_LEAN_AND_MEAN PLUME_NO_VOLK_IMPLEMENTATION)
target_compile_options(reeot_game PRIVATE ${reeot_rex_options} -O2)

# The plume objects of reeot.cmake, without the picture test
set_property(TARGET reeot_plume PROPERTY SOURCES ${reeot_plume}/plume_vulkan.cpp)

list(APPEND reeot_game_link_inputs "$<FILTER:$<TARGET_OBJECTS:reeot_recomp>,INCLUDE,\\.o$>" ${reeot_gamelogic_object}
	$<TARGET_OBJECTS:reeot_game> $<TARGET_OBJECTS:reeot_zstd> $<TARGET_OBJECTS:reeot_shader_cache>)
# The object file as well as its target: a target alone orders the link after
# the prelink but does not relink when only the object changed
set(reeot_game_link_depends reeot_recomp reeot_gamelogic_object ${reeot_gamelogic_object} reeot_game
	reeot_zstd reeot_shader_cache)
